# Application
APP_NAME="NitroPHP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Database — SQLite by default (zero setup; `nitro migrate` creates the file).
DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database.sqlite   # defaults to database/database.sqlite

# To use MySQL instead, comment the two lines above and uncomment these:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=nitro
# DB_USERNAME=root
# DB_PASSWORD=

# Query Logging
DB_LOG_QUERIES=false
# Sessions — native (default), file, array, redis, database.
# Deployed across more than one instance, use redis or database: a file session
# lives on the instance that wrote it and is lost on the next deploy.
SESSION_DRIVER=native
SESSION_LIFETIME=120

# Cache — file (default), redis, array, null.
CACHE_DRIVER=file

# Queue — database (default), redis, sync, array.
QUEUE_CONNECTION=database

# Redis — needed by the redis cache, session and queue drivers.
# REDIS_SCHEME=tcp          # tls for a managed provider that terminates TLS
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_USERNAME=           # only when the server uses ACL authentication
# REDIS_PASSWORD=

# Logging — file (default), stderr, stdout.
# On a container platform choose stderr: a log file inside the container is
# thrown away with the container.
LOG_CHANNEL=file

# Storage — local (default), public, s3.
FILESYSTEM_DISK=local

# Object storage, for the s3 disk (S3, R2, Spaces, MinIO).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_ENDPOINT=                      # set for R2, Spaces or MinIO
# AWS_USE_PATH_STYLE_ENDPOINT=false  # true for MinIO
# AWS_URL=                           # public base URL, if the bucket has one
